<Application
    x:Class="Grid.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="ApplicationPageBackgroundThemeColor">#181818</Color>
                    <Color x:Key="CardColor">#1F1F1F</Color>
                    <Color x:Key="CardHoverColor">#252526</Color>
                    <Color x:Key="GridPurple">#3794FF</Color>
                    <Color x:Key="GridCyan">#4FC1FF</Color>
                    <Color x:Key="MutedTextColor">#969696</Color>
                    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#303031" />
                    <SolidColorBrush x:Key="ShellSurfaceBrush" Color="#181818" />
                    <SolidColorBrush x:Key="ShellSidebarBrush" Color="#181818" />
                    <SolidColorBrush x:Key="ShellWorkbenchBrush" Color="#111111" />
                    <SolidColorBrush x:Key="ShellPanelBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="ShellInputBrush" Color="#242424" />
                    <SolidColorBrush x:Key="ShellDividerBrush" Color="#2B2D30" />
                    <SolidColorBrush x:Key="ShellTableHeaderGridLineBrush" Color="#454545" />
                    <SolidColorBrush x:Key="ShellTableBodyGridLineBrush" Color="#242629" />
                    <SolidColorBrush x:Key="ShellAccentBrush" Color="#3794FF" />
                    <SolidColorBrush x:Key="ShellWarningBrush" Color="#CCA700" />
                    <SolidColorBrush x:Key="ShellProblemBrush" Color="#F14C4C" />
                    <SolidColorBrush x:Key="ShellSuccessBrush" Color="#89D185" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#2D2D30" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#37373D" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#454545" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#454545" />
                    <SolidColorBrush x:Key="GridPurpleBrush" Color="{StaticResource GridPurple}" />
                    <SolidColorBrush x:Key="GridCyanBrush" Color="{StaticResource GridCyan}" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="CardBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="CardHoverBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="CardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ShellSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ShellSidebarBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ShellWorkbenchBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ShellPanelBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ShellInputBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ShellDividerBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ShellTableHeaderGridLineBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ShellTableBodyGridLineBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ShellAccentBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ShellWarningBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ShellProblemBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ShellSuccessBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SystemColorHighlightTextColorBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="GridPurpleBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="GridCyanBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="MutedTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Canonical inset from a panel outline to controls or child windows. -->
            <Thickness x:Key="ShellPanelContentInset">5</Thickness>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="EyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="ShellLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </Style>
            <Style x:Key="ShellTableHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ShellLabelStyle}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="ShellSearchTextBoxStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="ShellTableSectionButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="{ThemeResource ShellWorkbenchBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SectionRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}"
                                    BorderThickness="0,0,0,1">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="SectionRoot.Background" Value="#191919" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="SectionRoot.Background" Value="#202020" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ShellStatusPillStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="9,4" />
            </Style>
            <Style x:Key="ShellChromeButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="ChromeRoot"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ChromeRoot.Background" Value="{StaticResource CardHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ChromeRoot.Background" Value="{StaticResource ToggleButtonBackgroundChecked}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ChromeRoot.Background" Value="Transparent" />
                                                <Setter Target="ChromeRoot.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ShellChromeToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Padding="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- TabView otherwise adds its own 8-DIP top inset before each tab's margin. -->
            <Thickness x:Key="TabViewHeaderPadding">0</Thickness>
            <Style x:Key="ShellTabViewItemStyle" TargetType="TabViewItem">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="Margin" Value="0,3,3,3" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabViewItem">
                            <Grid x:Name="LayoutRoot" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Background" Value="{StaticResource CardHoverBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="#F2F2F2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Background" Value="#2A2A2D" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Background" Value="#2D2D30" />
                                                <Setter Target="ContentPresenter.Foreground" Value="#F2F2F2" />
                                                <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Background" Value="#343438" />
                                                <Setter Target="ContentPresenter.Foreground" Value="#FFFFFF" />
                                                <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Background" Value="#3B3B40" />
                                                <Setter Target="ContentPresenter.FontWeight" Value="SemiBold" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="DisabledStates">
                                        <VisualState x:Name="Enabled" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="IconStates">
                                        <VisualState x:Name="Icon" />
                                        <VisualState x:Name="NoIcon">
                                            <VisualState.Setters>
                                                <Setter Target="IconBox.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="TabWidthModes">
                                        <VisualState x:Name="StandardWidth" />
                                        <VisualState x:Name="Compact">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CloseIconStates">
                                        <VisualState x:Name="CloseButtonVisible" />
                                        <VisualState x:Name="CloseButtonCollapsed">
                                            <VisualState.Setters>
                                                <Setter Target="CloseButton.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="DragStates">
                                        <VisualState x:Name="NotDragging" />
                                        <VisualState x:Name="Dragging">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Opacity" Value="0.65" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="DraggingTarget" />
                                        <VisualState x:Name="Reordering" />
                                        <VisualState x:Name="ReorderingTarget" />
                                        <VisualState x:Name="DraggedPlaceholder" />
                                        <VisualState x:Name="ReorderedPlaceholder" />
                                        <VisualState x:Name="DragOver" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border
                                    x:Name="TabCard"
                                    Padding="{TemplateBinding Padding}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                    <Grid ColumnSpacing="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox x:Name="IconBox" Width="16" Height="16" VerticalAlignment="Center">
                                            <ContentControl Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TabViewTemplateSettings.IconElement}" />
                                        </Viewbox>
                                        <ContentPresenter
                                            x:Name="ContentPresenter"
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Stretch"
                                            VerticalContentAlignment="Center"
                                            Margin="0,-2,0,2"
                                            MinHeight="0"
                                            Padding="0"
                                            Content="{TemplateBinding Header}"
                                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                                            FontSize="13"
                                            Foreground="#CCCCCC" />
                                        <Button
                                            x:Name="CloseButton"
                                            Grid.Column="2"
                                            Width="18"
                                            Height="18"
                                            Padding="0"
                                            MinWidth="0"
                                            MinHeight="0"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            IsTabStop="False"
                                            Style="{StaticResource ShellChromeButtonStyle}">
                                            <Path Width="10" Height="10" Stretch="None"
                                                  Stroke="#CCCCCC" StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M1,1 L9,9 M9,1 L1,9" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ShellTabToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="0,3,0,3" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="TabCard"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Background" Value="{StaticResource CardHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Background" Value="#2A2A2D" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Background" Value="#2D2D30" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Background" Value="#343438" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Background" Value="#3B3B40" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="TabCard.Background" Value="#2D2D30" />
                                                <Setter Target="TabCard.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="VerticalPanelSplitterStyle" TargetType="Thumb">
                <Setter Property="Width" Value="4.25" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                    <Ellipse Width="1.5" Height="1.5" Fill="#686868" />
                                    <Ellipse Width="1.5" Height="1.5" Fill="#686868" />
                                    <Ellipse Width="1.5" Height="1.5" Fill="#686868" />
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HorizontalPanelSplitterStyle" TargetType="Thumb">
                <Setter Property="Height" Value="4.25" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                    <Ellipse Width="1.5" Height="1.5" Fill="#686868" />
                                    <Ellipse Width="1.5" Height="1.5" Fill="#686868" />
                                    <Ellipse Width="1.5" Height="1.5" Fill="#686868" />
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ActivityRailButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style x:Key="ShellSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="#CCCCCC" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

