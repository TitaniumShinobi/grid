<ContentDialog
    x:Class="Grid.App.Views.GameManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Manage game"
    CloseButtonText="Close"
    DefaultButton="Close">
    <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="520" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource Mode=TemplatedParent}}" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock x:Name="GameNameText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Connections are linked in place. Grid never imports, moves, repairs, or deletes external game or mod-manager data."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel x:Name="InstallationSelectorPanel" Spacing="4">
                <TextBlock Text="INSTALLATION" Style="{StaticResource ShellLabelStyle}" />
                <ComboBox x:Name="InstallationSelector" DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Connected installation" SelectionChanged="OnInstallationChanged" />
            </StackPanel>
            <InfoBar x:Name="EmptyState" IsOpen="True" Severity="Informational" Title="No connected installations"
                     Message="Connect an existing supported installation from this game." />
            <StackPanel x:Name="InstallationActions" Spacing="10">
                <TextBlock x:Name="InstallationStatusText" TextWrapping="Wrap" />
                <Button Content="Refresh external observations" Tag="refresh" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Refresh external observations" Click="OnActionClicked" />
                <StackPanel x:Name="Mo2AuthorizationActions" Spacing="10">
                    <Button Content="Review &amp; authorize all required read roots · This session" Tag="authorize-required" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Review and authorize all required read roots" Click="OnActionClicked" />
                    <Button Content="Authorize profiles root · This session" Tag="authorize-profiles" HorizontalAlignment="Stretch" Click="OnActionClicked" />
                    <Button Content="Authorize mods root · This session" Tag="authorize-mods" HorizontalAlignment="Stretch" Click="OnActionClicked" />
                    <Button Content="Authorize game directory · This session" Tag="authorize-game-directory" HorizontalAlignment="Stretch" Click="OnActionClicked" />
                    <Button Content="Authorize game Data · This session" Tag="authorize-game-data" HorizontalAlignment="Stretch" Click="OnActionClicked" />
                    <Button Content="Authorize Overwrite · This session" Tag="authorize-overwrite" HorizontalAlignment="Stretch" Click="OnActionClicked" />
                    <Button Content="Authorize game settings · This session" Tag="authorize-settings" HorizontalAlignment="Stretch" Click="OnActionClicked" />
                </StackPanel>
                <Border Height="1" Background="{ThemeResource ShellDividerBrush}" Margin="0,8" />
                <Button Content="Disconnect from Grid" Tag="disconnect" HorizontalAlignment="Stretch"
                        AutomationProperties.HelpText="Removes only Grid's local reference. External files remain unchanged."
                        Click="OnActionClicked" />
            </StackPanel>
            <Button x:Name="ConnectAnotherButton" Content="Connect another installation" Tag="connect"
                    HorizontalAlignment="Stretch" Click="OnActionClicked" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
