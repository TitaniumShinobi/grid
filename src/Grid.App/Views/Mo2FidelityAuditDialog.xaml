<ContentDialog
    x:Class="Grid.App.Views.Mo2FidelityAuditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Close"
    DefaultButton="Close"
    Title="MO2 fidelity and launch-readiness audit">

    <ScrollViewer
        MaxWidth="940"
        MaxHeight="720"
        AutomationProperties.Name="MO2 fidelity audit report"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
            <InfoBar
                x:Name="AuditBoundary"
                AutomationProperties.Name="Fidelity audit authority disclosure"
                IsClosable="False"
                IsOpen="True"
                Message="Grid compares immutable, provenance-bearing observations with the current connected MO2 evidence. It reports discrepancies without changing, repairing, sorting, or normalizing MO2 state."
                Severity="Informational"
                Title="READ-ONLY AUDIT · MO2 REMAINS AUTHORITATIVE" />

            <InfoBar
                x:Name="OverallStatus"
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Fidelity audit overall status"
                IsClosable="False"
                IsOpen="True" />

            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ShellLabelStyle}" Text="CONTEXT" />
                <TextBlock x:Name="ContextText" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Style="{StaticResource ShellLabelStyle}" Text="SNAPSHOT" />
                <TextBlock x:Name="SnapshotText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Style="{StaticResource ShellLabelStyle}" Text="OBSERVED" />
                <TextBlock x:Name="ObservedText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Style="{StaticResource ShellLabelStyle}" Text="NON-MUTATION" />
                <TextBlock x:Name="NonMutationText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>

            <StackPanel Spacing="7">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Audit checks" />
                <ListView
                    x:Name="AuditChecksList"
                    AutomationProperties.Name="Fidelity and readiness audit checks"
                    IsItemClickEnabled="False"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="14" Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Status}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding Evidence}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border x:Name="NoChecksState" Padding="14" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No audit checks are available for the current context. Launch remains unavailable." TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <CheckBox
                x:Name="AcknowledgeWarningsCheckBox"
                AutomationProperties.HelpText="Acknowledgement applies only to this exact audit snapshot and does not approve external mutation."
                AutomationProperties.Name="Acknowledge current audit warnings and unsupported evidence"
                Checked="OnAcknowledgementChanged"
                Content="I reviewed the warnings and unsupported evidence for this exact snapshot"
                Unchecked="OnAcknowledgementChanged"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
