<Page
    x:Class="Grid.App.Views.GameWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyDown="OnWorkspaceKeyDown"
    Unloaded="OnWorkspaceUnloaded"
    SizeChanged="OnWorkspaceSizeChanged">

    <Grid Padding="5,0,5,5">
        <Grid x:Name="ReadyState" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar
                x:Name="MockDisclosure"
                Margin="0,0,0,10"
                AutomationProperties.Name="Workspace data-boundary disclosure"
                IsClosable="False"
                IsOpen="False"
                Visibility="Collapsed"
                Message="Workspace evidence is read only. Grid does not silently repair, reorder, or mutate external state."
                Severity="Informational"
                Title="READ-ONLY WORKSPACE" />

            <Grid x:Name="PaneLayout" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftPaneColumn" Width="1*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="4.25" />
                    <ColumnDefinition x:Name="RightPaneColumn" Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="FirstPaneRow" Height="*" />
                    <RowDefinition x:Name="SecondPaneRow" Height="0" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="ModPane"
                    Grid.Row="0"
                    Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="4.25" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Border x:Name="ModWindow"
                            Background="{ThemeResource ShellWorkbenchBrush}"
                            BorderBrush="{ThemeResource ShellDividerBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                      <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="19"
                                    FontWeight="SemiBold"
                                    Text="Mods" />
                                <TextBlock
                                    x:Name="ModCountText"
                                    Foreground="{StaticResource MutedTextBrush}"
                                    Text="0 represented rows" />
                            </StackPanel>
                            <TextBlock
                                x:Name="SelectedModsText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource MutedTextBrush}"
                                Text="0 selected" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,288,0" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="EnabledFilterSelector"
                                AutomationProperties.Name="Enabled-state filter"
                                DisplayMemberPath="Label"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnQueryControlChanged" />
                            <ComboBox
                                x:Name="CategoryFilterSelector"
                                Grid.Column="1"
                                AutomationProperties.Name="Category filter"
                                DisplayMemberPath="Label"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnQueryControlChanged" />
                            <ToggleButton
                                x:Name="MoreFiltersButton"
                                Grid.Column="2"
                                AutomationProperties.Name="Show more mod filters"
                                Click="OnMoreFiltersClicked"
                                Content="More" />
                        </Grid>

                        <Grid x:Name="AdvancedFilterRow" Grid.Row="2" RowSpacing="7" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="ReconciliationFilterSelector"
                                    AutomationProperties.HelpText="Filter connected inventory by its reconciliation with the configured MO2 mods directory."
                                    AutomationProperties.Name="Inventory reconciliation filter"
                                    DisplayMemberPath="Label"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OnQueryControlChanged" />
                                <ToggleButton
                                    x:Name="WarningFilterButton"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Show inventory rows with warnings only"
                                    Checked="OnQueryControlChanged"
                                    Content="Warnings"
                                    Unchecked="OnQueryControlChanged" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton
                                    x:Name="ConflictFilterButton"
                                    AutomationProperties.Name="Show represented conflicts only"
                                    Checked="OnQueryControlChanged"
                                    Content="Conflicts"
                                    Unchecked="OnQueryControlChanged" />
                                <ComboBox
                                    x:Name="UpdateStateFilterSelector"
                                    Grid.Column="1"
                                    AutomationProperties.HelpText="Filter by local metadata update state. Connected states are not online verified."
                                    AutomationProperties.Name="Local metadata update-state filter"
                                    DisplayMemberPath="Label"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="OnQueryControlChanged" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="SortFilterRow" Grid.Row="3" ColumnSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="SortSelector"
                                AutomationProperties.Name="Sort mods"
                                DisplayMemberPath="Label"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="OnQueryControlChanged" />
                            <Button
                                x:Name="SortDirectionButton"
                                Grid.Column="1"
                                MinWidth="96"
                                AutomationProperties.Name="Change mod sort direction"
                                Click="OnSortDirectionClicked"
                                Content="Ascending" />
                            <ComboBox
                                x:Name="SeparatorSelector"
                                Grid.Column="2"
                                MinWidth="150"
                                AutomationProperties.HelpText="Jump to a separator in the authoritative MO2 order. Choosing one restores the authoritative view without changing MO2."
                                AutomationProperties.Name="Jump to MO2 separator"
                                DisplayMemberPath="Label"
                                PlaceholderText="Jump to section"
                                SelectionChanged="OnSeparatorSelectionChanged" />
                        </Grid>

                        <InfoBar
                            x:Name="InventoryViewStatus"
                            Grid.Row="4"
                            AutomationProperties.LiveSetting="Polite"
                            AutomationProperties.Name="Mod inventory view status"
                            IsClosable="False"
                            IsOpen="False"
                            Severity="Informational"
                            Visibility="Collapsed" />

                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid
                                Height="28"
                                Background="{ThemeResource ShellWorkbenchBrush}">
                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="2.4*" />
                                    <ColumnDefinition x:Name="ModConflictHeaderColumn" Width="76" />
                                    <ColumnDefinition x:Name="ModFlagsHeaderColumn" Width="56" />
                                    <ColumnDefinition x:Name="ModPriorityHeaderColumn" Width="72" />
                                    <ColumnDefinition x:Name="ModVersionHeaderColumn" Width="72" />
                                    <ColumnDefinition x:Name="ModCategoryHeaderColumn" Width="86" />
                            </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,1,1" />
                                <Border Grid.Column="1" Padding="5,0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource ShellTableHeaderTextStyle}" Text="MOD NAME" /></Border>
                                <Border Grid.Column="2" Padding="5,0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource ShellTableHeaderTextStyle}" Text="CONFLICTS" /></Border>
                                <Border Grid.Column="3" Padding="5,0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource ShellTableHeaderTextStyle}" Text="FLAGS" TextAlignment="Center" /></Border>
                                <Border Grid.Column="4" Padding="5,0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource ShellTableHeaderTextStyle}" Text="PRIORITY" TextAlignment="Center" /></Border>
                                <Border Grid.Column="5" Padding="5,0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource ShellTableHeaderTextStyle}" Text="VERSION" /></Border>
                                <Border Grid.Column="6" Padding="5,0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource ShellTableHeaderTextStyle}" Text="CATEGORY" /></Border>
                                <Thumb Grid.Column="2" Tag="2" Width="5" HorizontalAlignment="Left" Background="Transparent" DragDelta="OnModColumnDragDelta" AutomationProperties.Name="Resize Conflicts column" />
                                <Thumb Grid.Column="3" Tag="3" Width="5" HorizontalAlignment="Left" Background="Transparent" DragDelta="OnModColumnDragDelta" AutomationProperties.Name="Resize Flags column" />
                                <Thumb Grid.Column="4" Tag="4" Width="5" HorizontalAlignment="Left" Background="Transparent" DragDelta="OnModColumnDragDelta" AutomationProperties.Name="Resize Priority column" />
                                <Thumb Grid.Column="5" Tag="5" Width="5" HorizontalAlignment="Left" Background="Transparent" DragDelta="OnModColumnDragDelta" AutomationProperties.Name="Resize Version column" />
                                <Thumb Grid.Column="6" Tag="6" Width="5" HorizontalAlignment="Left" Background="Transparent" DragDelta="OnModColumnDragDelta" AutomationProperties.Name="Resize Category column" />
                            </Grid>

                            <ListView
                                x:Name="ModsList"
                                Grid.Row="1"
                                AutomationProperties.Name="Represented mod list"
                                Background="{ThemeResource ShellWorkbenchBrush}"
                                IsMultiSelectCheckBoxEnabled="False"
                                SelectionChanged="OnModSelectionChanged"
                                SelectionMode="Multiple">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection />
                                </ListView.ItemContainerTransitions>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="28" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="EnableSelectedMenuItem" Click="OnEnableSelectedClicked" Text="Enable selected · Mock session" />
                                        <MenuFlyoutItem x:Name="DisableSelectedMenuItem" Click="OnDisableSelectedClicked" Text="Disable selected · Mock session" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="MoveUpMenuItem" Click="OnMoveUpClicked" Text="Move up · Mock priority" />
                                        <MenuFlyoutItem x:Name="MoveDownMenuItem" Click="OnMoveDownClicked" Text="Move down · Mock priority" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem IsEnabled="False" Text="Check for updates · Unavailable (no network)" />
                                        <MenuFlyoutItem IsEnabled="False" Text="Open location · Unavailable (no filesystem integration)" />
                                    </MenuFlyout>
                                </ListView.ContextFlyout>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="28">
                                            <Border BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,0,1"
                                                    Visibility="{Binding ModVisibility}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="2.4*" />
                                                    <ColumnDefinition Width="{Binding Columns.Second}" />
                                                    <ColumnDefinition Width="{Binding Columns.Third}" />
                                                    <ColumnDefinition Width="{Binding Columns.Fourth}" />
                                                    <ColumnDefinition Width="{Binding Columns.Fifth}" />
                                                    <ColumnDefinition Width="{Binding Columns.Sixth}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Padding="5,0" BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,1,0">
                                                    <CheckBox
                                                        Width="20"
                                                        Height="20"
                                                        MinWidth="0"
                                                        MinHeight="0"
                                                        Margin="0"
                                                        Padding="0"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        AutomationProperties.Name="{Binding ToggleAutomationName}"
                                                        Click="OnModEnabledCheckBoxClicked"
                                                        IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{Binding ToggleHelpText}">
                                                        <CheckBox.RenderTransform>
                                                            <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                                                        </CheckBox.RenderTransform>
                                                    </CheckBox>
                                                </Border>
                                                <Border Grid.Column="1" Padding="5,0" BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,1,0"><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Detail}" /></Border>
                                                <Border Grid.Column="2" Padding="5,0" BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,1,0"><TextBlock VerticalAlignment="Center" Text="{Binding ConflictLabel}" TextTrimming="CharacterEllipsis" /></Border>
                                                <Border Grid.Column="3" Padding="5,0" BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,1,0"><TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding FlagsLabel}" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding FlagsDetail}" /></Border>
                                                <Border Grid.Column="4" Padding="5,0" BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,1,0"><TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Priority}" TextAlignment="{Binding PriorityAlignment}" TextTrimming="CharacterEllipsis" /></Border>
                                                <Border Grid.Column="5" Padding="5,0" BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,1,0"><TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding InstalledVersion}" TextAlignment="{Binding InstalledVersionAlignment}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding InstalledVersion}" /></Border>
                                                <Border Grid.Column="6" Padding="5,0"><TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding Category}" TextAlignment="{Binding CategoryAlignment}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Category}" /></Border>
                                            </Grid>
                                            </Border>
                                            <Button
                                                Height="28"
                                                Padding="5,0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}"
                                                AutomationProperties.HelpText="Toggle this MO2 separator section"
                                                Click="OnSeparatorRowClicked"
                                                Style="{StaticResource ShellTableSectionButtonStyle}"
                                                Visibility="{Binding SeparatorVisibility}">
                                                <Grid ColumnDefinitions="18,*">
                                                    <FontIcon FontSize="10" Glyph="{Binding SeparatorGlyph}" />
                                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <StackPanel Grid.Row="5" Spacing="8">
                            <InfoBar
                                x:Name="WorkspaceCommandStatus"
                                AutomationProperties.LiveSetting="Assertive"
                                AutomationProperties.Name="Mock mod command status"
                                IsClosable="True"
                                IsOpen="False" />
                            <StackPanel x:Name="MockCommandActions" Orientation="Horizontal" Spacing="7">
                                <Button
                                    x:Name="EnableSelectedButton"
                                    AutomationProperties.Name="Enable selected mods in mock session"
                                    Click="OnEnableSelectedClicked"
                                    Content="Enable · Mock" />
                                <Button
                                    x:Name="DisableSelectedButton"
                                    AutomationProperties.Name="Disable selected mods in mock session"
                                    Click="OnDisableSelectedClicked"
                                    Content="Disable · Mock" />
                                <Button
                                    x:Name="MoveUpButton"
                                    AutomationProperties.HelpText="Available only for one selected mod in unfiltered ascending mod-priority order."
                                    AutomationProperties.Name="Move selected mod up in mock priority"
                                    Click="OnMoveUpClicked"
                                    Content="Move up · Mock" />
                                <Button
                                    x:Name="MoveDownButton"
                                    AutomationProperties.HelpText="Available only for one selected mod in unfiltered ascending mod-priority order."
                                    AutomationProperties.Name="Move selected mod down in mock priority"
                                    Click="OnMoveDownClicked"
                                    Content="Move down · Mock" />
                            </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Grid.Row="2" Width="280" Height="24" HorizontalAlignment="Right"
                            Background="{ThemeResource ShellWorkbenchBrush}" BorderBrush="#454545"
                            BorderThickness="1" CornerRadius="4">
                        <AutoSuggestBox x:Name="ModSearchBox" MinHeight="0" Padding="6,0"
                                 VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                 CornerRadius="3" FontSize="12" VerticalContentAlignment="Center"
                                 TextBoxStyle="{StaticResource ShellSearchTextBoxStyle}"
                                 AutomationProperties.HelpText="Search represented mod names, categories, sources, and installed versions."
                                 AutomationProperties.Name="Search mods" PlaceholderText="Search mods"
                                 TextChanged="OnModSearchTextChanged" />
                    </Border>
                </Grid>

                <Thumb
                    x:Name="PaneSplitter"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource VerticalPanelSplitterStyle}"
                    AutomationProperties.HelpText="Drag horizontally, use Left or Right arrow keys to resize, or press Home to reset."
                    AutomationProperties.Name="Resize mod and environment panes"
                    DragDelta="OnSplitterDragDelta"
                    IsTabStop="True"
                    KeyDown="OnSplitterKeyDown" />

                <Grid
                    x:Name="EnvironmentPane"
                    Grid.Row="0"
                    Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="EnvironmentTabHost" Background="Transparent">
                      <Grid RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="SelectedModDetailText"
                            Grid.Row="3"
                            FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}"
                            Text="No mods selected"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />

                        <Expander
                            x:Name="SelectionInspector"
                            Grid.Row="3"
                            AutomationProperties.HelpText="Shows read-only MO2 reconciliation, metadata, local update evidence, provenance, and warnings for the selected mod."
                            AutomationProperties.Name="Selected mod inventory details"
                            Header="Selected mod details"
                            IsExpanded="False"
                            Visibility="Collapsed">
                            <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel Padding="0,8,4,6" Spacing="8">
                                    <TextBlock x:Name="InspectorSummaryText" FontWeight="SemiBold" Text="No mod selected" TextWrapping="Wrap" />
                                    <TextBlock x:Name="InspectorAuthorityText" Foreground="{StaticResource MutedTextBrush}" Text="Select one inventory row to review its evidence." TextWrapping="Wrap" />
                                    <TextBlock x:Name="InspectorMetadataText" TextWrapping="Wrap" />
                                    <TextBlock x:Name="InspectorUpdateText" TextWrapping="Wrap" />
                                    <TextBlock x:Name="InspectorProvenanceText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                    <InfoBar
                                        x:Name="InspectorWarningStatus"
                                        AutomationProperties.Name="Selected inventory warnings"
                                        IsClosable="False"
                                        IsOpen="False"
                                        Severity="Warning" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>

                        <InfoBar
                            x:Name="NoEnvironmentTabsState"
                            Grid.Row="2"
                            IsClosable="False"
                            IsOpen="False"
                            Message="The selected adapter exposes no profile-environment tabs for this context."
                            Severity="Warning"
                            Title="No supported environment capabilities" />

                        <StackPanel x:Name="ResolvedEnvironmentControls" Grid.Row="1" Spacing="0" Visibility="Collapsed">
                            <InfoBar
                                x:Name="EnvironmentObservationStatus"
                                AutomationProperties.LiveSetting="Polite"
                                AutomationProperties.Name="Resolved environment observation status"
                                IsClosable="False"
                                IsOpen="True"
                                Message="Plugins, Archives, and Data have not been scanned for this profile. Select Scan read only to build the index."
                                Severity="Informational"
                                Title="NOT SCANNED"
                                Visibility="Collapsed" />
                            <ProgressBar x:Name="EnvironmentProgressBar" AutomationProperties.Name="Environment indexing progress" IsIndeterminate="True" Visibility="Collapsed" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="7" Visibility="Collapsed">
                                <Button x:Name="PreviousEnvironmentPageButton" AutomationProperties.Name="Previous environment evidence page" Click="OnPreviousEnvironmentPageClicked" Content="Previous" IsEnabled="False" />
                                <TextBlock x:Name="EnvironmentPageText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Page 1" />
                                <Button x:Name="NextEnvironmentPageButton" AutomationProperties.Name="Next environment evidence page" Click="OnNextEnvironmentPageClicked" Content="Next" IsEnabled="False" />
                            </StackPanel>
                            <Grid ColumnSpacing="7">
                                <Button
                                    x:Name="CancelEnvironmentButton"
                                    AutomationProperties.Name="Cancel environment indexing"
                                    Click="OnCancelEnvironmentClicked"
                                    Content="Cancel"
                                    IsEnabled="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>

                        <TabView
                            x:Name="EnvironmentTabs"
                            Grid.Row="0"
                            Margin="-9,0,0,0"
                            Background="{ThemeResource ShellWorkbenchBrush}"
                            AutomationProperties.Name="Profile environment tabs"
                            IsAddTabButtonVisible="False"
                            TabWidthMode="SizeToContent"
                            SelectionChanged="OnEnvironmentTabSelectionChanged"
                            TabCloseRequested="OnUnexpectedTabCloseRequested">
                            <TabView.TabItemTemplate>
                                <DataTemplate>
                                    <TabViewItem
                                        Style="{StaticResource ShellTabViewItemStyle}"
                                        AutomationProperties.HelpText="{Binding Description}"
                                        Header="{Binding Label}"
                                        IsClosable="False"
                                        ToolTipService.ToolTip="{Binding Description}">
                                        <Border x:Name="EnvironmentWindow"
                                                Margin="9,0,0,0"
                                                Background="{ThemeResource ShellWorkbenchBrush}"
                                                BorderThickness="0">
                                        <Grid Padding="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid
                                                Height="28"
                                                Background="{ThemeResource ShellWorkbenchBrush}"
                                                Visibility="{Binding HeaderVisibility}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="{Binding Columns.Second}" />
                                                    <ColumnDefinition Width="{Binding Columns.Third}" />
                                                    <ColumnDefinition Width="{Binding Columns.Fourth}" />
                                                    <ColumnDefinition Width="{Binding Columns.Fifth}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Padding="5,0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource ShellTableHeaderTextStyle}" Text="{Binding Header1}" /></Border>
                                                <Border Grid.Column="1" Padding="5,0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource ShellTableHeaderTextStyle}" Text="{Binding Header2}" TextAlignment="{Binding Header2Alignment}" /></Border>
                                                <Border Grid.Column="2" Padding="5,0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource ShellTableHeaderTextStyle}" Text="{Binding Header3}" /></Border>
                                                <Border Grid.Column="3" Padding="5,0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,1,1"><TextBlock Style="{StaticResource ShellTableHeaderTextStyle}" Text="{Binding Header4}" TextAlignment="{Binding Header4Alignment}" /></Border>
                                                <Border Grid.Column="4" Padding="5,0" BorderBrush="{ThemeResource ShellTableHeaderGridLineBrush}" BorderThickness="0,0,0,1"><TextBlock Style="{StaticResource ShellTableHeaderTextStyle}" Text="{Binding Header5}" /></Border>
                                                <Thumb Grid.Column="1" Tag="1" Width="5" HorizontalAlignment="Left" Background="Transparent" DragDelta="OnEnvironmentColumnDragDelta" AutomationProperties.Name="Resize second environment column" />
                                                <Thumb Grid.Column="2" Tag="2" Width="5" HorizontalAlignment="Left" Background="Transparent" DragDelta="OnEnvironmentColumnDragDelta" AutomationProperties.Name="Resize third environment column" />
                                                <Thumb Grid.Column="3" Tag="3" Width="5" HorizontalAlignment="Left" Background="Transparent" DragDelta="OnEnvironmentColumnDragDelta" AutomationProperties.Name="Resize fourth environment column" />
                                                <Thumb Grid.Column="4" Tag="4" Width="5" HorizontalAlignment="Left" Background="Transparent" DragDelta="OnEnvironmentColumnDragDelta" AutomationProperties.Name="Resize fifth environment column" />
                                            </Grid>
                                             <ListView
                                                Grid.Row="1"
                                                AutomationProperties.Name="{Binding AutomationName}"
                                                Background="{ThemeResource ShellWorkbenchBrush}"
                                                ItemsSource="{Binding Rows}"
                                                IsItemClickEnabled="True"
                                                ItemClick="OnEnvironmentRowInvoked"
                                                SelectedItem="{Binding SelectedRow, Mode=OneWay}"
                                                SelectionChanged="OnEnvironmentRowSelectionChanged"
                                                 SelectionMode="Single"
                                                 Visibility="{Binding ListVisibility}">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="MinHeight" Value="28" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                 <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border MinHeight="28" BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="{Binding Columns.Second}" />
                                                                <ColumnDefinition Width="{Binding Columns.Third}" />
                                                                <ColumnDefinition Width="{Binding Columns.Fourth}" />
                                                                <ColumnDefinition Width="{Binding Columns.Fifth}" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Padding="5,0" BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,1,0"><TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Column1}" TextAlignment="{Binding Column1Alignment}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Detail}" /></Border>
                                                            <Border Grid.Column="1" Padding="5,0" BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,1,0"><TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding Column2}" TextAlignment="{Binding Column2Alignment}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Detail}" /></Border>
                                                            <Border Grid.Column="2" Padding="5,0" BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,1,0"><TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding Column3}" TextAlignment="{Binding Column3Alignment}" TextTrimming="CharacterEllipsis" /></Border>
                                                            <Border Grid.Column="3" Padding="5,0" BorderBrush="{ThemeResource ShellTableBodyGridLineBrush}" BorderThickness="0,0,1,0"><TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding Column4}" TextAlignment="{Binding Column4Alignment}" TextTrimming="CharacterEllipsis" /></Border>
                                                            <Border Grid.Column="4" Padding="5,0"><TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Center" Text="{Binding Column5}" TextAlignment="{Binding Column5Alignment}" TextTrimming="CharacterEllipsis" /></Border>
                                                        </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                            <Border
                                                Grid.RowSpan="2"
                                                Padding="20"
                                                Background="{ThemeResource ShellWorkbenchBrush}"
                                                CornerRadius="8"
                                                Visibility="{Binding EmptyVisibility}">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    Text="{Binding EmptyMessage}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                        </Grid>
                                        </Border>
                                    </TabViewItem>
                                </DataTemplate>
                            </TabView.TabItemTemplate>
                        </TabView>
                      </Grid>
                      <Border x:Name="EnvironmentWindowOutline"
                              Margin="0,30,0,0"
                              Background="Transparent"
                              BorderBrush="{ThemeResource ShellDividerBrush}"
                              BorderThickness="1"
                              CornerRadius="4"
                              IsHitTestVisible="False"
                              Canvas.ZIndex="20" />
                    </Grid>
                    <Border Grid.Row="2" Width="280" Height="24" HorizontalAlignment="Right"
                            Background="{ThemeResource ShellWorkbenchBrush}" BorderBrush="#454545"
                            BorderThickness="1" CornerRadius="4">
                        <AutoSuggestBox x:Name="EnvironmentSearchBox" MinHeight="0" Padding="6,0"
                                 VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                 CornerRadius="3" FontSize="12" VerticalContentAlignment="Center"
                                 TextBoxStyle="{StaticResource ShellSearchTextBoxStyle}"
                                 AutomationProperties.HelpText="Filter the current resolved Plugins, Archives, or Data evidence without changing MO2 order."
                                 AutomationProperties.Name="Search resolved environment" PlaceholderText="Search plugins"
                                 TextChanged="OnEnvironmentSearchTextChanged" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border
            x:Name="UnavailableState"
            MaxWidth="720"
            Padding="26"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource CardStyle}"
            Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock
                    x:Name="UnavailableTitle"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="No installation available" />
                <TextBlock
                    x:Name="UnavailableDetail"
                    Foreground="{StaticResource MutedTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            x:Name="EmptyProfileState"
            MaxWidth="720"
            Padding="26"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource CardStyle}"
            Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="No active profile" />
                <TextBlock
                    x:Name="EmptyProfileDetail"
                    Foreground="{StaticResource MutedTextBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border
            x:Name="NoModListState"
            MaxWidth="720"
            Padding="26"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource CardStyle}"
            Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock x:Name="NoModListTitle" FontSize="22" FontWeight="SemiBold" Text="Mod list unsupported" />
                <TextBlock
                    x:Name="NoModListDetail"
                    Foreground="{StaticResource MutedTextBrush}"
                    Text="The selected adapter does not expose a mod-list capability. Grid will not fabricate Skyrim-style rows for this game."
                    TextWrapping="Wrap" />
                <InfoBar
                    x:Name="ConnectedProfileObservation"
                    AutomationProperties.Name="Connected MO2 profile observation boundary"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
