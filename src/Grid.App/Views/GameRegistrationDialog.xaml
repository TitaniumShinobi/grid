<ContentDialog
    x:Class="Grid.App.Views.GameRegistrationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add game"
    PrimaryButtonText="Create new profile"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnCreateNewClicked">
    <ScrollViewer
        MaxHeight="680"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="620" HorizontalAlignment="Stretch" Spacing="14">
            <TextBlock x:Name="SelectedGameName" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Choose a detected local installation or browse to its directory. GRID will then look for existing manager profiles associated with that exact installation." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Assertive" />
            <ProgressRing x:Name="DiscoveryProgress" IsActive="False" Visibility="Collapsed" Width="24" Height="24" HorizontalAlignment="Left" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="Local installation" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Detection is optional. Browse is always available." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Find my games" AutomationProperties.Name="Find my games" Click="OnScanClicked" />
                    <Button Content="Browse..." AutomationProperties.Name="Browse for game directory" Click="OnBrowseClicked" />
                </StackPanel>
            </Grid>
            <ListView x:Name="InstallationCandidates" MinHeight="90" MaxHeight="220" AutomationProperties.Name="Local game installations" SelectionChanged="OnInstallationSelectionChanged" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InstallRoot}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Evidence}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Ready" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border x:Name="ExistingProfilesPanel" Visibility="Collapsed" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="9">
                    <TextBlock x:Name="ExistingProfilesHeading" Text="GRID discovered existing profiles" Style="{StaticResource SectionTitleStyle}" />
                    <ProgressRing x:Name="ProfileDiscoveryProgress" IsActive="False" Visibility="Collapsed" Width="20" Height="20" HorizontalAlignment="Left" />
                    <ItemsControl x:Name="ExistingProfiles" AutomationProperties.Name="Existing profiles for selected game installation">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ManagerName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Evidence}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding UseLabel}" AutomationProperties.Name="{Binding UseLabel}" VerticalAlignment="Center" Click="OnUseExistingClicked" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Discovery is read-only. Nothing is connected until you choose an existing profile or create a new one." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="5">
                    <TextBlock Text="REVIEW" Style="{StaticResource ShellLabelStyle}" />
                    <TextBlock x:Name="ReviewText" Text="Select a real local installation." TextWrapping="Wrap" />
                    <TextBlock Text="Create new profile preserves Add Game behavior: GRID stores the reviewed game installation and creates a new profile named after the game." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
