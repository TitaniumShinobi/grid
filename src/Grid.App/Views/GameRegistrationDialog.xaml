<ContentDialog
    x:Class="Grid.App.Views.GameRegistrationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add games to Grid"
    PrimaryButtonText="Register selected"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnRegisterClicked">
    <ScrollViewer MaxHeight="620">
        <StackPanel Width="620" Spacing="14">
            <TextBlock Text="Grid detected these installations from local provider evidence. Select the editions you want in your collection, or browse to another game directory." TextWrapping="Wrap" />
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Assertive" />
            <ProgressRing x:Name="DiscoveryProgress" IsActive="True" Width="28" Height="28" HorizontalAlignment="Left" />
            <ListView x:Name="GameCandidates" SelectionMode="Multiple" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Detected game installations">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InstallRoot}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Evidence}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Ready" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Scan again" Click="OnScanClicked" />
                <Button Content="Browse to game directory…" Click="OnBrowseClicked" />
            </StackPanel>
            <Border x:Name="VortexConnectionPanel" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="VORTEX CATALOG" Style="{StaticResource ShellLabelStyle}" />
                    <TextBlock Text="Connect this GTA installation to its Vortex staging folder. Grid will observe staged mod directories and keep its catalog current while Grid is open." TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="VortexStagingPath" PlaceholderText="Select the Vortex mod staging folder" AutomationProperties.Name="Vortex mod staging folder" />
                        <Button Grid.Column="1" Content="Browse…" Click="OnBrowseVortexClicked" />
                    </Grid>
                    <TextBlock Text="This connection is read-only. A staged folder alone does not prove deployment or enabled state, so Grid labels that state as unresolved." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="5">
                    <TextBlock Text="REVIEW" Style="{StaticResource ShellLabelStyle}" />
                    <TextBlock x:Name="ReviewText" Text="Select at least one installation." TextWrapping="Wrap" />
                    <TextBlock x:Name="ManagerText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Registration saves only Grid’s local connection record. Existing provider, manager, and game files remain where they are." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
