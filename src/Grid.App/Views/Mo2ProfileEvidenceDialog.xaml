<ContentDialog
    x:Class="Grid.App.Views.Mo2ProfileEvidenceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Close"
    DefaultButton="Close"
    Title="MO2 profile evidence">

    <ScrollViewer MaxWidth="900" MaxHeight="720" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
            <InfoBar
                AutomationProperties.Name="MO2 profile evidence disclosure"
                IsClosable="False"
                IsOpen="True"
                Message="This is point-in-time read-only evidence. Selecting a profile in Grid does not change MO2's active profile, profile files, INIs, saves, or any external state. Save contents are never inspected."
                Severity="Informational"
                Title="SELECTED IN GRID · EXTERNAL STATE UNCHANGED" />

            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource ShellLabelStyle}" Text="PROFILE" />
                <TextBlock x:Name="ProfileNameText" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Style="{StaticResource ShellLabelStyle}" Text="MO2 STATE" />
                <TextBlock x:Name="ManagerStateText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Style="{StaticResource ShellLabelStyle}" Text="LOCAL INIS" />
                <TextBlock x:Name="LocalSettingsText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Style="{StaticResource ShellLabelStyle}" Text="LOCAL SAVES" />
                <TextBlock x:Name="LocalSavesText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
                <TextBlock Grid.Row="4" Style="{StaticResource ShellLabelStyle}" Text="SNAPSHOT" />
                <TextBlock x:Name="SnapshotText" Grid.Row="4" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" />
            </Grid>

            <StackPanel Spacing="7">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Profile source files" />
                <ListView
                    x:Name="SourcesList"
                    AutomationProperties.Name="MO2 profile source-file observations"
                    IsItemClickEnabled="False"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="14" Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding Fingerprint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Border x:Name="NoSourcesState" Padding="14" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No profile source observations are available. Grid has not fabricated evidence." TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
