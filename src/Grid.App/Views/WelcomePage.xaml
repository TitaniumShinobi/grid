<Page
    x:Class="Grid.App.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer AutomationProperties.Name="GRID Welcome" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="900" Padding="48,44,48,64" HorizontalAlignment="Center">
            <StackPanel Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="Welcome to GRID" FontSize="34" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Start with the game you want GRID to manage, or connect an existing profile environment. Discovery is available when it helps, but it is never required."
                        FontSize="15"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="22" Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Browse Game Catalog" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Choose a supported game, then use a detected installation or browse to its local game directory."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Content="Browse Game Catalog" AutomationProperties.Name="Browse Game Catalog" Click="OnBrowseCatalogClicked" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                </Border>

                <Border Padding="22" Style="{StaticResource CardStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Find my games" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Optionally scan bounded local provider evidence, then review any matching installations in the Game Catalog."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Content="Find my games" AutomationProperties.Name="Find my games" Click="OnFindGamesClicked" />
                    </Grid>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="You can also add an existing profile from the Game Catalog. GRID's adapters identify its manager, game, installation, mods, plugins, and configuration before a connection is saved." TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Left" Content="Continue to Home" AutomationProperties.Name="Continue to Home" Click="OnContinueHomeClicked" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
