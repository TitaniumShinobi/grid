<ContentDialog
    x:Class="Grid.App.Views.Mo2ExecutableConfigurationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Close"
    DefaultButton="Close"
    Title="MO2 executable configuration · Read only">

    <ScrollViewer MaxWidth="820" MaxHeight="680" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <InfoBar
                AutomationProperties.Name="MO2 executable read-only disclosure"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational"
                Title="MO2 CONFIG · READ ONLY"
                Message="Grid preserves this opaque MO2 configuration as observed. It cannot edit or execute it." />

            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ClassificationText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource ShellLabelStyle}" Text="BINARY" />
                <TextBox x:Name="BinaryText" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Observed executable binary path" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource ShellLabelStyle}" Text="WORKING DIRECTORY" />
                <TextBox x:Name="WorkingDirectoryText" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Observed executable working directory" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource ShellLabelStyle}" Text="OPAQUE MO2 ARGUMENTS" />
                <TextBox
                    x:Name="ArgumentsText"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    AutomationProperties.HelpText="Arguments are inert text and are masked until locally revealed. They are never parsed into a command."
                    AutomationProperties.Name="Masked inert MO2 arguments" />
                <Button
                    x:Name="RevealArgumentsButton"
                    HorizontalAlignment="Left"
                    Click="OnRevealArgumentsClicked"
                    Content="Reveal inert text · Local"
                    AutomationProperties.HelpText="Reveals the exact local text in this dialog only. It does not copy, parse, log, or execute it."
                    AutomationProperties.Name="Reveal inert MO2 arguments locally" />
            </StackPanel>

            <TextBlock Style="{StaticResource ShellLabelStyle}" Text="MO2 FLAGS" />
            <TextBlock x:Name="FlagsText" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource ShellLabelStyle}" Text="APPLICATION ICON EVIDENCE" />
            <TextBlock x:Name="IconStatusText" AutomationProperties.Name="Observed application icon status" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource ShellLabelStyle}" Text="SOURCE AND PROVENANCE" />
            <TextBlock x:Name="ProvenanceText" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource ShellLabelStyle}" Text="UNSUPPORTED FIELDS AND WARNINGS" />
            <TextBlock x:Name="WarningsText" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
