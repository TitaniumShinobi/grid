<ContentDialog
    x:Class="Grid.App.Views.GeneratedOutputInspectorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Close"
    DefaultButton="Close"
    Title="Generated output evidence · Read only">

    <ScrollViewer MaxWidth="760" MaxHeight="660" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <InfoBar
                AutomationProperties.Name="Generated output observation disclosure"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational"
                Title="EXTERNAL OUTPUT · READ ONLY"
                Message="Grid observed this output without moving, repairing, regenerating, or changing it. Change status compares observations only; it does not prove tool inputs are current." />
            <TextBlock x:Name="NameText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource ShellLabelStyle}" Text="ASSOCIATION EVIDENCE" />
            <TextBlock x:Name="EvidenceText" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource ShellLabelStyle}" Text="FINGERPRINT AND COMPARISON" />
            <TextBlock x:Name="FingerprintText" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource ShellLabelStyle}" Text="WARNINGS" />
            <TextBlock x:Name="WarningsText" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
