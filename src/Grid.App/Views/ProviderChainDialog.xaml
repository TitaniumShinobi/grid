<ContentDialog
    x:Class="Grid.App.Views.ProviderChainDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Effective Data provider chain"
    CloseButtonText="Close">
    <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Spacing="10">
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="Read-only evidence only. Grid does not mount, extract, copy, or change any provider."
                Severity="Informational"
                Title="MO2 RESOLVED VIEW · NO USVFS REPLACEMENT" />
            <TextBlock x:Name="VirtualPathText" FontFamily="Consolas" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ResolutionText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            <ListView
                x:Name="ProvidersList"
                AutomationProperties.Name="Providers in precedence order"
                IsItemClickEnabled="False"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8" Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="{Binding SourceName}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Kind}" />
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding Reason}" TextWrapping="Wrap" />
                            <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding WinnerLabel}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <InfoBar
                x:Name="DiscrepancyStatus"
                AutomationProperties.Name="Provider-chain discrepancies"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
