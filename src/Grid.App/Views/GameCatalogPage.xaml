<Page
    x:Class="Grid.App.Views.GameCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40,32,40,48" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="18">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Game Catalog" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <HyperlinkButton
                Padding="4,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Add profile"
                Click="OnAddProfileClicked"
                Content="Add profile" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Text="Choose a supported game to connect a real local installation. Detection can help, and Browse is always available in the Add Game step."
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <Grid Grid.Row="2" ColumnDefinitions="*,220,Auto" ColumnSpacing="10">
            <TextBox
                x:Name="SearchBox"
                AutomationProperties.Name="Search Game Catalog"
                PlaceholderText="Search games"
                TextChanged="OnSearchChanged" />
            <ComboBox
                x:Name="FilterBox"
                Grid.Column="1"
                AutomationProperties.Name="Filter Game Catalog"
                SelectedIndex="0"
                SelectionChanged="OnFilterChanged">
                <ComboBoxItem Content="All supported games" Tag="all" />
                <ComboBoxItem Content="Connected games" Tag="connected" />
                <ComboBoxItem Content="Not connected" Tag="available" />
                <ComboBoxItem Content="Detected locally" Tag="detected" />
            </ComboBox>
            <Button
                x:Name="FindGamesButton"
                Grid.Column="2"
                AutomationProperties.Name="Find my games"
                Click="OnFindGamesClicked"
                Content="Find my games" />
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="10">
            <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Assertive" />
            <ListView
                x:Name="CatalogList"
                Grid.Row="1"
                AutomationProperties.Name="Game Catalog entries"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Button
                            AutomationProperties.Name="{Binding Name}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="0"
                            Click="OnGameButtonClicked">
                            <Grid MinHeight="64" Padding="14,10" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
