<ContentDialog
    x:Class="Grid.App.Views.ToolConfigurationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Close"
    DefaultButton="Close"
    Title="Launch targets · Mock configuration">

    <Grid
        x:Name="DialogLayout"
        MaxWidth="940"
        MaxHeight="680"
        HorizontalAlignment="Stretch"
        RowSpacing="12"
        SizeChanged="OnDialogContentSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            AutomationProperties.Name="Mock launch configuration disclosure"
            IsClosable="False"
            IsOpen="True"
            Message="Edits replace only the in-memory mock catalog and reset when Grid restarts. No executable or directory is probed."
            Severity="Informational"
            Title="MOCK SESSION · NO PATHS PROBED · EXTERNAL STATE UNCHANGED" />

        <Grid x:Name="EditorLayout" Grid.Row="1" ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="TargetListPanel" Padding="10" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Adapter-declared targets" />
                    <ListView
                        x:Name="TargetList"
                        Grid.Row="1"
                        AutomationProperties.Name="Configured launch targets"
                        SelectionChanged="OnTargetSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="4" Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Definition.Name}" TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding PresentationStatus}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer x:Name="TargetEditorScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="TargetNameText" FontSize="20" FontWeight="SemiBold" Text="Select a target" />
                    <TextBlock x:Name="TargetMetadataText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <InfoBar
                        x:Name="AvailabilityInfo"
                        AutomationProperties.Name="Target availability"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Warning" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource ShellLabelStyle}" Text="EXECUTABLE BASE" />
                            <ComboBox
                                x:Name="ExecutableAnchorSelector"
                                AutomationProperties.Name="Executable path base"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Style="{StaticResource ShellLabelStyle}" Text="EXECUTABLE RELATIVE PATH" />
                            <TextBox
                                x:Name="ExecutablePathBox"
                                AutomationProperties.HelpText="A represented relative path. Rooted paths and traversal segments are rejected."
                                AutomationProperties.Name="Executable relative path" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource ShellLabelStyle}" Text="WORKING DIRECTORY BASE" />
                            <ComboBox
                                x:Name="WorkingAnchorSelector"
                                AutomationProperties.Name="Working directory base"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Style="{StaticResource ShellLabelStyle}" Text="WORKING DIRECTORY RELATIVE PATH" />
                            <TextBox
                                x:Name="WorkingDirectoryBox"
                                AutomationProperties.Name="Working directory relative path" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource ShellLabelStyle}" Text="ENVIRONMENT POLICY" />
                        <ComboBox
                            x:Name="EnvironmentPolicySelector"
                            AutomationProperties.HelpText="Selects typed policy metadata. Arbitrary environment variables are not accepted."
                            AutomationProperties.Name="Environment policy"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource ShellLabelStyle}" Text="TARGET ARGUMENTS · ONE LITERAL ARGUMENT PER LINE" />
                        <TextBox
                            x:Name="ArgumentsBox"
                            MinHeight="104"
                            AcceptsReturn="True"
                            AutomationProperties.HelpText="Each nonblank trimmed line remains one literal argument. Grid does not parse quotes or shell syntax."
                            AutomationProperties.Name="Structured target arguments"
                            TextWrapping="NoWrap" />
                    </StackPanel>

                    <CheckBox
                        x:Name="DefaultTargetCheckBox"
                        AutomationProperties.Name="Use as this profile's default launch target"
                        Content="Use as this profile's default target" />

                    <InfoBar
                        x:Name="OperationStatus"
                        AutomationProperties.LiveSetting="Assertive"
                        AutomationProperties.Name="Mock launch configuration status"
                        IsClosable="True"
                        IsOpen="False" />

                    <Button
                        x:Name="ApplyButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Apply mock launch configuration"
                        Click="OnApplyClicked"
                        Content="Apply · Mock session"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
