{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grid tool registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tools"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolDefinition" }
    }
  },
  "$defs": {
    "toolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "toolId",
        "displayName",
        "compatibility",
        "adapter",
        "observationMode",
        "rootCapabilityIds",
        "supportedClassIds",
        "limits"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "toolId": {
          "type": "string",
          "pattern": "^grid\\.tool\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "displayName": { "type": "string", "minLength": 1 },
        "compatibility": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gameId", "evidenceCapabilityIds", "provenance"],
            "properties": {
              "gameId": {
                "type": "string",
                "pattern": "^game\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
              },
              "evidenceCapabilityIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^grid\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                }
              },
              "provenance": { "type": "string", "minLength": 1 }
            }
          }
        },
        "adapter": { "type": "string", "minLength": 1 },
        "observationMode": {
          "enum": ["InProcessRead", "ExistingOutputRead", "ExplicitProcessLaunch"]
        },
        "rootCapabilityIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^grid\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          }
        },
        "supportedClassIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^grid\\.class\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeoutSeconds", "maximumOutputBytes"],
          "properties": {
            "timeoutSeconds": { "type": "integer", "minimum": 1 },
            "maximumOutputBytes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
