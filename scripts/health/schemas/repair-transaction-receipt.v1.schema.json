{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://grid.local/schemas/health/repair-transaction-receipt.v1.schema.json",
  "title": "Grid Repair Transaction Receipt v1", "type": "object",
  "required": ["schemaVersion", "transactionId", "specificationId", "specificationSha256", "baselineManifestSha256", "journalSha256", "result", "completedAt"],
  "properties": { "schemaVersion": { "const": 1 }, "transactionId": { "type": "string" }, "specificationId": { "type": "string" }, "specificationSha256": { "$ref": "#/$defs/sha256" }, "baselineManifestSha256": { "$ref": "#/$defs/sha256" }, "journalSha256": { "$ref": "#/$defs/sha256" }, "result": { "$ref": "mod-chain-repair-result.v1.schema.json" }, "completedAt": { "type": "string", "format": "date-time" } },
  "$defs": { "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" } }, "additionalProperties": false
}
