{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://grid.local/schemas/health/staged-tree-manifest.v1.schema.json",
  "title": "Grid Staged Tree Manifest v1", "type": "object",
  "required": ["schemaVersion", "specificationId", "componentId", "root", "treeSha256", "files", "verifiedAt"],
  "properties": { "schemaVersion": { "const": 1 }, "specificationId": { "type": "string" }, "componentId": { "type": "string" }, "root": { "type": "string" }, "treeSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }, "files": { "type": "array", "items": { "type": "object", "required": ["path", "sizeBytes", "sha256"], "properties": { "path": { "type": "string" }, "sizeBytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" } }, "additionalProperties": false } }, "verifiedAt": { "type": "string", "format": "date-time" } },
  "additionalProperties": false
}
