{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grid authorization grant v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "grantId",
    "reviewId",
    "state",
    "authorityClass",
    "semanticBinding",
    "semanticBindingSha256",
    "secretProof",
    "issuedAt",
    "expiresAt",
    "lease",
    "consumption",
    "failure"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "grantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "reviewId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "state": {
      "enum": [
        "Issued",
        "Executing",
        "Consumed",
        "Failed"
      ]
    },
    "authorityClass": {
      "enum": [
        "Read",
        "Mutation"
      ]
    },
    "semanticBinding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Grid authorization semantic binding v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "actorId",
        "sessionId",
        "workspaceId",
        "requestId",
        "submissionId",
        "envelopeSha256",
        "planSha256",
        "scopeSha256",
        "proposalOrSpecificationId",
        "proposalOrSpecificationSha256",
        "capabilities",
        "targets",
        "normalizedInputSha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "submissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "envelopeSha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "planSha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "scopeSha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "proposalOrSpecificationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "proposalOrSpecificationSha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capabilityId",
              "capabilityVersion",
              "adapterId",
              "adapterVersion"
            ],
            "properties": {
              "capabilityId": {
                "type": "string",
                "minLength": 1
              },
              "capabilityVersion": {
                "type": "string",
                "minLength": 1
              },
              "adapterId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "adapterVersion": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "normalizedInputSha256": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        }
      }
    },
    "semanticBindingSha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "secretProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "iterations",
        "saltBase64",
        "hashBase64"
      ],
      "properties": {
        "algorithm": {
          "const": "PBKDF2-HMAC-SHA1"
        },
        "iterations": {
          "type": "integer",
          "minimum": 100000
        },
        "saltBase64": {
          "type": "string",
          "minLength": 8
        },
        "hashBase64": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "lease": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "leaseId",
            "consumerId",
            "acquiredAt",
            "expiresAt"
          ],
          "properties": {
            "leaseId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "consumerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "acquiredAt": {
              "type": "string",
              "format": "date-time"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time"
            },
            "completedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      ]
    },
    "consumption": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "authorization-consumption.v1.schema.json"
        }
      ]
    },
    "failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "authorization-failure.v1.schema.json"
        }
      ]
    }
  }
}
