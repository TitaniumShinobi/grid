{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://grid.local/schemas/health/rollback-manifest.v1.schema.json",
  "title": "Grid Rollback Manifest v1", "type": "object",
  "required": ["schemaVersion", "specificationId", "status", "entries"],
  "properties": { "schemaVersion": { "const": 1 }, "specificationId": { "type": "string" }, "status": { "enum": ["Planned", "Available", "Verified", "Failed", "Indeterminate"] }, "entries": { "type": "array", "items": { "type": "object", "required": ["componentId", "originalPath", "rollbackPath", "treeSha256"], "properties": { "componentId": { "type": "string" }, "originalPath": { "type": "string" }, "rollbackPath": { "type": "string" }, "treeSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" } }, "additionalProperties": false } } },
  "additionalProperties": false
}
