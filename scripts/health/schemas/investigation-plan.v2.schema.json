{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grid.local/schemas/health/investigation-plan.v2.schema.json",
  "title": "Grid InvestigationPlan v2",
  "type": "object",
  "required": [
    "schemaVersion", "caseId", "gameId", "originalRequest", "capabilities",
    "candidatePlugins", "providerSeeds", "observedForms", "collectorQueries", "missingInputs",
    "status", "provenance", "createdAt", "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "caseId": { "type": "string", "minLength": 1 },
    "gameId": { "type": "string", "minLength": 1 },
    "installationId": { "type": ["string", "null"] },
    "profileId": { "type": ["string", "null"] },
    "originalRequest": { "type": "string", "minLength": 1 },
    "purpose": { "enum": ["Diagnosis", "Baseline"] },
    "requiredGates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "InstallationBaseline", "ProfileBaseline", "PluginBaseline", "AssetBaseline",
          "PriorCaseBaseline", "SymptomEvidenceBaseline", "RuntimeReferenceBaseline"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capabilityId", "capabilityVersion"],
        "properties": {
          "capabilityId": { "type": "string", "pattern": "^grid\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "capabilityVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
        },
        "additionalProperties": false
      }
    },
    "normalizedSymptoms": { "type": "array", "items": { "type": "string" } },
    "locations": { "type": "array", "items": { "type": "string" } },
    "candidatePlugins": { "type": "array" },
    "providerSeeds": { "type": "array" },
    "observedForms": { "type": "array" },
    "hypotheses": { "type": "array" },
    "evidenceReferences": { "type": "array" },
    "parentCaseIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "collectorQueries": { "type": "array" },
    "missingInputs": { "type": "array", "items": { "type": "string" } },
    "recommendedCollectors": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["NeedsContext", "NeedsEvidence", "ReadyToCollect", "Diagnosed", "Failed"] },
    "provenance": { "type": "array" },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
