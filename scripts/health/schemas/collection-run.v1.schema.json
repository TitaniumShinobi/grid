{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grid.local/schemas/collection-run.v1.schema.json",
  "title": "Grid diagnostic collection run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "caseId", "state", "startedAt", "completedAt", "planFingerprint", "resourcePolicyVersion", "gates", "sufficiency", "checkpoints", "primaryFailure", "secondaryFailures"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "state": { "enum": ["Planned", "Running", "PausedAtCheckpoint", "Completed", "Failed", "Cancelled"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "planFingerprint": { "$ref": "#/definitions/sha256" },
    "resourcePolicyVersion": { "type": "string", "minLength": 1 },
    "gates": { "type": "array", "items": { "$ref": "evidence-gate.v1.schema.json" } },
    "sufficiency": { "$ref": "baseline-sufficiency.v1.schema.json" },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkpointId", "state", "path", "sha256"],
        "properties": {
          "checkpointId": { "type": "string", "minLength": 1 },
          "state": { "enum": ["Sealed", "Invalid"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/definitions/sha256" }
        }
      }
    },
    "primaryFailure": { "$ref": "#/definitions/failure" },
    "secondaryFailures": { "type": "array", "items": { "$ref": "#/definitions/nonNullFailure" } }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "failure": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/nonNullFailure" }
      ]
    },
    "nonNullFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "at"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
