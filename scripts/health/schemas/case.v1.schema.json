{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grid.local/schemas/health/case.v1.schema.json",
  "title": "Grid Diagnostic Case v1",
  "type": "object",
  "required": ["schemaVersion", "caseId", "rawPrompt", "status", "createdAt", "updatedAt", "context", "evidence", "history"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "rawPrompt": { "type": "string", "minLength": 1 },
    "status": { "enum": ["NeedsContext", "NeedsEvidence", "ReadyToCollect", "Collecting", "Diagnosed", "Failed", "Incomplete"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "context": { "type": "object" },
    "diagnosticResultPath": { "type": ["string", "null"] },
    "evidence": { "type": "array" },
    "history": { "type": "array" }
  },
  "additionalProperties": true
}
