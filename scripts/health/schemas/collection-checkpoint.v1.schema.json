{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grid.local/schemas/collection-checkpoint.v1.schema.json",
  "title": "Grid diagnostic collection checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checkpointId", "runId", "caseId", "sequence", "state", "createdAt", "artifactCount", "artifactFingerprint", "resourceUsage", "gates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "checkpointId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "state": { "enum": ["Sealed", "Invalid"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "artifactCount": { "type": "integer", "minimum": 0 },
    "artifactFingerprint": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "resourceUsage": { "$ref": "#/definitions/resourceUsage" },
    "gates": { "type": "array", "items": { "$ref": "evidence-gate.v1.schema.json" } }
  },
  "definitions": {
    "resourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallClockSeconds", "filesObserved", "bytesRead", "bytesHashed", "attachmentBytes", "priorCases", "concurrentReads", "filesSinceCheckpoint", "secondsSinceCheckpoint"],
      "properties": {
        "wallClockSeconds": { "type": "integer", "minimum": 0 },
        "filesObserved": { "type": "integer", "minimum": 0 },
        "bytesRead": { "type": "integer", "minimum": 0 },
        "bytesHashed": { "type": "integer", "minimum": 0 },
        "attachmentBytes": { "type": "integer", "minimum": 0 },
        "priorCases": { "type": "integer", "minimum": 0 },
        "concurrentReads": { "type": "integer", "minimum": 0 },
        "filesSinceCheckpoint": { "type": "integer", "minimum": 0 },
        "secondsSinceCheckpoint": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
