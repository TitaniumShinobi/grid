{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grid MDBO capability manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ownerScope", "registrationEngineRoot", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "ownerScope": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string" }
      }
    },
    "registrationEngineRoot": {
      "type": "string",
      "pattern": "^grid\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "modelProposalBoundary": { "type": "object" },
    "supportingFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/mdboCapability" }
    }
  },
  "$defs": {
    "mdboCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "capabilityVersion",
        "l1Lineage",
        "semanticParent",
        "realization",
        "sufficiency",
        "verificationContract"
      ],
      "properties": {
        "capabilityId": {
          "type": "string",
          "pattern": "^grid\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "capabilityVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "l1Lineage": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "semanticParent": { "type": "string", "minLength": 1 },
        "realization": { "type": "string", "minLength": 1 },
        "sufficiency": { "type": "string", "minLength": 1 },
        "verificationContract": { "type": "string", "minLength": 1 }
      }
    }
  }
}
