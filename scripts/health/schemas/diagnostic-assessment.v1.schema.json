{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grid.local/schemas/health/diagnostic-assessment.v1.schema.json",
  "title": "Grid deterministic diagnostic assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "assessmentId", "caseId", "state", "contextFingerprint",
    "evidenceFingerprint", "policyVersion", "assessor", "assertions",
    "nextEvidenceDecision", "assessmentFingerprint", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assessmentId": { "type": "string", "minLength": 1 },
    "caseId": { "type": "string", "minLength": 1 },
    "state": { "enum": ["EvidenceAssessed", "InsufficientEvidence", "CauseProven"] },
    "contextFingerprint": { "type": "string", "minLength": 1 },
    "evidenceFingerprint": { "$ref": "#/$defs/sha256" },
    "policyVersion": { "const": "diagnostic-assessment.v1" },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": { "const": "DeterministicRuleEngine" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assertionId", "classification", "statement", "evidenceIds", "contradictingEvidenceIds"],
        "properties": {
          "assertionId": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["ObservedFact", "DerivedFact", "SupportedHypothesis", "InsufficientEvidence", "ProvenCause"] },
          "statement": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "contradictingEvidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "missingInputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "ruleId": { "type": ["string", "null"] },
          "ruleVersion": { "type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "satisfiedProofObligationIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "nextEvidenceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "collectorCapabilityId", "reason", "requiredInputs"],
      "properties": {
        "status": { "enum": ["NotRequired", "Required"] },
        "collectorCapabilityId": { "type": ["string", "null"] },
        "reason": { "type": "string" },
        "requiredInputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "assessmentFingerprint": { "$ref": "#/$defs/sha256" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
  }
}
