{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grid.local/schemas/health/class-recipe.v1.schema.json",
  "title": "Grid ClassRecipe v1",
  "type": "object",
  "required": ["schemaVersion", "classId", "recipeVersion", "displayName", "iconId", "coverage", "supportedGames", "selectionPolicy", "evidencePolicy", "pipelines"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "classId": { "type": "string", "pattern": "^grid\\.class\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "recipeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "iconId": { "type": "string", "pattern": "^grid\\.icon\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "coverage": { "enum": ["Registered", "Unsupported"] },
    "supportedGames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" } },
    "selectionPolicy": {
      "type": "object",
      "required": ["mods", "tools"],
      "properties": {
        "mods": { "$ref": "#/$defs/countPolicy" },
        "tools": {
          "allOf": [
            { "$ref": "#/$defs/countPolicy" },
            { "type": "object", "required": ["allowedToolIds"], "properties": { "allowedToolIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^grid\\.tool\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" } } } }
          ]
        }
      },
      "additionalProperties": false
    },
    "evidencePolicy": { "type": "object", "required": ["requiredAnyOf"], "properties": { "requiredAnyOf": { "type": "array", "items": { "type": "array", "minItems": 1, "items": { "enum": ["providerSeeds", "candidatePlugins", "observedForms", "locations", "claims.text", "evidenceReferences"] } } } }, "additionalProperties": false },
    "gameplayCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["capabilityId", "displayName", "intentPhrases"],
        "properties": {
          "capabilityId": { "type": "string", "pattern": "^grid\\.capability\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "intentPhrases": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
        },
        "additionalProperties": false
      }
    },
    "pipelines": {
      "type": "object",
      "required": ["diagnose", "propose", "execute", "verify"],
      "properties": {
        "diagnose": { "$ref": "#/$defs/pipeline" }, "propose": { "$ref": "#/$defs/pipeline" },
        "execute": { "$ref": "#/$defs/pipeline" }, "verify": { "$ref": "#/$defs/pipeline" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "countPolicy": { "type": "object", "required": ["minimum", "maximum"], "properties": { "minimum": { "type": "integer", "minimum": 0 }, "maximum": { "type": ["integer", "null"], "minimum": 0 } } },
    "pipeline": { "oneOf": [{ "type": "null" }, { "type": "object", "required": ["rootCapabilityIds"], "properties": { "rootCapabilityIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^grid\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" } } }, "additionalProperties": false }] }
  },
  "additionalProperties": false
}
