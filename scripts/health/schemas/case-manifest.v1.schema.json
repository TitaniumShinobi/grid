{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grid.local/schemas/case-manifest.v1.schema.json",
  "title": "Grid sealed diagnostic case manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "storeVersion", "sealedAt", "semanticBaselineFingerprint", "artifacts", "blobs", "runs", "manifestSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/:*?\"<>|]+$" },
    "storeVersion": { "const": "grid.case-store.v1" },
    "sealedAt": { "type": "string", "format": "date-time" },
    "semanticBaselineFingerprint": { "$ref": "#/definitions/sha256" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sizeBytes", "sha256"],
        "properties": {
          "path": { "$ref": "#/definitions/relativePath" },
          "sizeBytes": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/definitions/sha256" }
        }
      }
    },
    "blobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "sizeBytes"],
        "properties": {
          "sha256": { "$ref": "#/definitions/sha256" },
          "sizeBytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "state", "path", "sha256"],
        "properties": {
          "runId": { "type": "string", "minLength": 1 },
          "state": { "$ref": "#/definitions/runState" },
          "path": { "$ref": "#/definitions/relativePath" },
          "sha256": { "$ref": "#/definitions/sha256" }
        }
      }
    },
    "manifestSha256": { "$ref": "#/definitions/sha256" }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
    "runState": { "enum": ["Planned", "Running", "PausedAtCheckpoint", "Completed", "Failed", "Cancelled"] }
  }
}
