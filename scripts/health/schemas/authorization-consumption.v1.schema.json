{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grid authorization consumption v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "consumptionId",
    "grantId",
    "leaseId",
    "state",
    "semanticBindingSha256",
    "completedAt",
    "detail"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "consumptionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "grantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "leaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "state": {
      "const": "Consumed"
    },
    "semanticBindingSha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "detail": {
      "type": "string"
    }
  }
}
