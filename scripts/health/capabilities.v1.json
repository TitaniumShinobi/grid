      ],
      "dependencies": [
        "grid.health.remediation-proposal.materialize"
      ],
      "sideEffectClassification": "CaseLocalWrite",
      "requiredAuthority": {
        "kind": "ExplicitGrantIssuance",
        "description": "Issues a durable proposal-bound grant; the public proposal or its digest is never an executable credential."
      },
      "rollback": {
        "mode": "NotRequired",
        "description": "Issuance changes only the case-local authorization store; unused grants expire and consumed grants remain auditable."
      },
      "terminalStates": [
        "Authorized",
        "Rejected",
        "Stale"
      ]
    },
