          "currentContextFingerprint",
          "currentEvidenceFingerprint",
          "authorizationStoreRoot",
          "semanticBinding"
        ]
      },
      "outputSchema": {
        "$ref": "./schemas/authorization-grant.v2.schema.json"
      },
      "preconditions": [
        "Proposal, context, evidence, exact targets, semantic binding, authority class, and expiry are current.",
