  "capabilities": [
    {
      "capabilityId": "grid.health.case.execute",
      "capabilityVersion": "1.0.0",
      "ownerScope": {
        "kind": "SharedHealth"
      },
      "implementation": {
        "files": [
          "scripts/health/Invoke-GridHealth.ps1"
        ],
        "entryPoint": "Invoke-GridHealth.ps1"
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "request"
        ],
        "properties": {
          "request": {
            "type": "string",
            "minLength": 1
          },
          "gameId": {
            "type": "string"
          },
          "outputRoot": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "status",
          "caseId",
          "diagnosticResult"
        ]
      },
      "preconditions": [
        "The operator explicitly invokes the case entry point.",
        "Any external process launch satisfies the selected adapter contract."
      ],
      "dependencies": [
        "grid.health.capability.resolve",
        "grid.health.adapter.resolve",
        "grid.health.case.lifecycle",
        "grid.health.investigation-plan.materialize",
        "grid.health.diagnostic-result.materialize"
      ],
      "sideEffectClassification": "ExternalProcessLaunch",
      "requiredAuthority": {
        "kind": "ExplicitProcessLaunch",
        "description": "Case creation is explicit; native launch authority remains bounded by the selected game capability."
      },
      "rollback": {
        "mode": "DelegatedToDependencies",
        "description": "Remove case-local artifacts; external process handling follows the invoked collector contract."
      },
      "terminalStates": [
        "NeedsContext",
        "NeedsEvidence",
        "ReadyToCollect",
        "Diagnosed",
        "Failed"
      ]
    },
    {
