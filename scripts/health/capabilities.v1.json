      "rollback": {
        "mode": "RemoveCaseArtifacts",
        "description": "Remove only the newly created case directory or restore the prior atomic case document."
      },
      "terminalStates": [
        "NeedsContext",
        "NeedsEvidence",
        "ReadyToCollect",
        "Diagnosed",
        "Failed"
      ]
    },
