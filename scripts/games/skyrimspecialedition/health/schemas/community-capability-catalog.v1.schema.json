{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grid.local/schemas/games/skyrimspecialedition/community-capability-catalog.v1.schema.json",
  "title": "Grid Skyrim community capability catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gameId", "observedAtUtc", "expiresAtUtc", "sources", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "gameId": { "const": "skyrimspecialedition" },
    "observedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "provider", "uri", "claims"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
          "claims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "displayName", "installedProviders", "communityCandidates"],
        "properties": {
          "capabilityId": { "type": "string", "pattern": "^grid\\.capability\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "installedProviders": { "type": "array", "items": { "$ref": "#/$defs/installedProvider" } },
          "communityCandidates": { "type": "array", "items": { "$ref": "#/$defs/communityCandidate" } }
        }
      }
    }
  },
  "$defs": {
    "modIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "aliases"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "nexusModId": { "type": "integer", "minimum": 1 },
        "aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "installedProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "name", "role", "nexusModId", "aliases", "requiredComponents", "sourceIds"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "nexusModId": { "type": "integer", "minimum": 1 },
        "aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "requiredComponents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["componentId", "displayName", "archivePrefixes"],
            "properties": {
              "componentId": { "type": "string", "minLength": 1 },
              "displayName": { "type": "string", "minLength": 1 },
              "archivePrefixes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "communityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "name", "provider", "uri", "providerLocator", "version", "requiredDependencies", "optionalFeatures", "minimumVersionsWhenPresent", "unresolvedCoexistenceProviderIds", "sourceIds"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
        "providerLocator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gameId", "modId"],
          "properties": {
            "gameId": { "const": "skyrimspecialedition" },
            "modId": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        "version": { "type": "string", "minLength": 1 },
        "requiredDependencies": { "type": "array", "items": { "$ref": "#/$defs/modIdentity" } },
        "optionalFeatures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["displayName", "dependencies"],
            "properties": {
              "displayName": { "type": "string", "minLength": 1 },
              "dependencies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/modIdentity" } }
            }
          }
        },
        "minimumVersionsWhenPresent": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["displayName", "aliases", "minimumVersion"],
            "properties": {
              "displayName": { "type": "string", "minLength": 1 },
              "nexusModId": { "type": "integer", "minimum": 1 },
              "aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "minimumVersion": { "type": "string", "minLength": 1 }
            }
          }
        },
        "unresolvedCoexistenceProviderIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
