# AUTH deployment environment for the Grid native-windows client.
# Two shapes coexist: an .env file for the AUTH process, and the
# AUTH_APP_CONFIG_* variables AUTH loads its AuthAppConfig from. See
# docs/reference/api-endpoints.md and docs/how-to/setup-and-verify.md.

# --- AUTH core (serving the deployment) ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:3100
AUTH_APP_CONFIG_PATH=config/appConfig.json
AUTH_APP_CONFIG_PATHS=config/oauthConfig.json
GENERAL_IDS_SECRET=change-me-to-32-random-characters-min

# Cookie names the desktop client reads (AuthOptions.sessionCookieName /
# refreshCookieName MUST match in config/grid.auth.config.json).
# AUTH_COOKIE_NAME=auth_sid
# AUTH_REFRESH_COOKIE_NAME=auth_rid

# --- Cross-product: provider secrets (service/env or AUTH_*_CLIENT_) ---
# GRID_MICROSOFT_CLIENT_ID=...
# GRID_MICROSOFT_CLIENT_SECRET=...
# GRID_GITHUB_CLIENT_ID=...
# GRID_GITHUB_CLIENT_SECRET=...
# GRID_GOOGLE_CLIENT_ID=...
# GRID_GOOGLE_CLIENT_SECRET=...

# --- Magic email transport (AUTH_SSM_* shaped into delivery) ---
# Required for the "Continue with email" option in the native client.
# AUTH_POSTAL_URL=...
# AUTH_POSTAL_API_KEY=...
# AUTH_MAGIC_EMAIL_FROM=Grid <no-reply@grid.app>
# AUTH_MAGIC_DELIVERY_SECRET=change-me-32-characters-min

# --- Loopback / allowed-origin notes for the desktop client ---
# The deployment's AuthAppConfig.allowedOrigins MUST include
#   http://127.0.0.1:51706
# so magic email links open in the native listener (config/grid.auth.server-config.example.json).
# Providers configured to key their own success intercept round-trip to AUTH;
# the OAuth success redirect (authorizationUiUrl) redirects to
#   http://127.0.0.1:51706/grid-natives-callback?code=...&state=...  (loopback public client)