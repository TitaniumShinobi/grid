{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grid.local/schemas/verification-manifest.v1.schema.json",
  "title": "GRID verification manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestId", "lanes", "suites"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestId": { "const": "grid.verification.v1" },
    "description": { "type": "string" },
    "lanes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "enum": ["Portable", "WindowsSource", "Distribution"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "order", "kind", "path", "lanes", "platform", "configurationMode", "arguments", "category"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "kind": { "enum": ["PowerShell", "DotNetBuild", "DotNetRun", "UiDotNetRun"] },
          "path": { "type": "string", "minLength": 1 },
          "lanes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["Portable", "WindowsSource", "Distribution"] }
          },
          "platform": { "enum": ["Any", "Windows"] },
          "configurationMode": { "enum": ["None", "Required"] },
          "arguments": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
