<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\core\features\files\AuthorizedFileService.cs"
             Link="Core\Files\AuthorizedFileService.cs" />
    <Compile Include="..\..\core\features\document_viewer\*.cs"
             Link="Core\DocumentViewer\%(Filename)%(Extension)" />
    <Compile Include="..\..\core\features\explorer\*.cs"
             Link="Core\Explorer\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
