{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://life.technology/start/schemas/startup-event-v1.schema.json",
  "title": "LIFE Startup Event v1",
  "type": "object",
  "required": ["contract", "startup_id", "product_id", "contract_version", "stage_id", "stage_class", "state_generation", "registration_generation", "state_snapshot_id", "started_at", "completed_at", "status", "required", "cache_hit", "rebuild_reason", "progress_units", "dependencies", "error", "readiness", "receipt_ref"],
  "properties": {
    "contract": { "const": "life-startup-event/v1" },
    "startup_id": { "type": "string", "minLength": 1 },
    "product_id": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "string", "const": "1.0.0" },
    "stage_id": { "type": "string", "minLength": 1 },
    "stage_class": { "enum": ["REGISTRATION", "STARTUP_REQUIRED", "BACKGROUND_OPTIONAL", "STALE_REFRESH", "REBUILD"] },
    "state_generation": { "type": ["string", "null"] },
    "registration_generation": { "type": ["string", "null"] },
    "state_snapshot_id": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["STARTED", "COMPLETED", "SKIPPED", "FAILED", "RETRYING"] },
    "required": { "type": "boolean" },
    "cache_hit": { "type": ["boolean", "null"] },
    "rebuild_reason": { "type": ["string", "null"] },
    "progress_units": {
      "type": "object",
      "required": ["status", "completed", "total"],
      "properties": {
        "status": { "enum": ["KNOWN", "INDETERMINATE"] },
        "completed": { "type": "integer", "minimum": 0 },
        "total": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "error": { "type": ["object", "null"] },
    "readiness": { "type": ["object", "null"] },
    "receipt_ref": { "type": ["object", "null"] }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "required": ["dependency_id", "status", "required"],
      "properties": {
        "dependency_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "INDETERMINATE"] },
        "required": { "type": "boolean" },
        "observed_at": { "type": ["string", "null"], "format": "date-time" },
        "details": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
